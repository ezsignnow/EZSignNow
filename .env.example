# ============================================================
# EZSignNow — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
VITE_SUPABASE_PROJECT_ID="your-supabase-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxxxxxxxxxxxxxx"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# ── Google OAuth (configure in Supabase Dashboard > Auth > Providers) ──
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── Stripe ───────────────────────────────────────────────────
VITE_STRIPE_PUBLISHABLE_KEY="pk_live_xxxxxxxxxxxxxxxxxxxx"
VITE_STRIPE_SECRET_KEY="sk_live_xxxxxxxxxxxxxxxxxxxx"

# ── Zoho SMTP (for sending signing invitation emails) ────────
SMTP_HOST="smtppro.zoho.com"
SMTP_PORT=587
SMTP_USER="support@yourdomain.com"
SMTP_PASS="your-smtp-password"
SMTP_SENDER_NAME="EZSignNow"
SMTP_SENDER_EMAIL="support@yourdomain.com"
